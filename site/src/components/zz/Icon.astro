---
interface Props {
	name: string;
	size?: number;
	class?: string;
}

const { name, size = 14, class: cls } = Astro.props;

const files = import.meta.glob<string>('../../icons/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

const raw = files[`../../icons/${name}.svg`];
if (!raw) throw new Error(`zz Icon: no src/icons/${name}.svg`);

const open = raw.indexOf('<svg');
const close = raw.indexOf('>', open);
const root = raw.slice(open, close).replace(/\s(width|height)=(["'])[^"']*\2/g, '');
const svg = `${raw.slice(0, open)}${root} focusable="false"${raw.slice(close)}`;
---

<span class={cls ? `zz-icon ${cls}` : 'zz-icon'} style={`--zz-icon-size:${size}px`} aria-hidden="true">
	<Fragment set:html={svg} />
</span>
