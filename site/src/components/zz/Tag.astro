---
interface Props {
	variant?: 'secondary' | 'primary' | 'success' | 'danger';
	compact?: boolean;
	size?: number;
	class?: string;
}

const { variant = 'secondary', compact = false, size, class: cls } = Astro.props;
const classes = ['zz-tag', `zz-tag--${variant}`, compact && 'zz-tag--compact', cls]
	.filter(Boolean)
	.join(' ');
---

<span class={classes} style={size ? `font-size:${size}px` : undefined}><slot /></span>
