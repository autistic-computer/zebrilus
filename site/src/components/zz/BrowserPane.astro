---
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
	url: string;
	tabs?: string[];
	recents?: string[];
	bootPage?: string;
	canBack?: boolean;
	canForward?: boolean;
	background?: string;
	class?: string;
}

const {
	url,
	tabs = [],
	recents = [],
	bootPage,
	canBack = Boolean(url),
	canForward = false,
	background = 'var(--zz-bg)',
	class: cls,
} = Astro.props;
---

<div class:list={['browser', cls]} data-browser data-url={url} data-boot-page={bootPage}>
	<div class="toolbar">
		<div class="cluster">
			<Button icon="arrow-left" label="Back" disabled={!canBack} />
			<Button icon="arrow-right" label="Forward" disabled={!canForward} />
			<Button icon="redo-2" label="Reload" />
		</div>

		<div class="strip">
			<div class="address">
				<input
					class="url"
					type="text"
					value={url}
					placeholder="Search or enter a URL"
					aria-label="Address"
					spellcheck="false"
					autocomplete="off"
					autocapitalize="off"
					autocorrect="off"
				/>
				<span class="spinner" aria-hidden="true"></span>
			</div>
			{
				tabs.map((tab) => (
					<div class="pill">
						<span class="pill-label">{tab}</span>
						<Button icon="xmark" label="Close tab" class="pill-close" />
					</div>
				))
			}
			<Button icon="plus" label="New tab" />
		</div>

		<div class="cluster">
			<Button icon="inspector" label="Select element" />
			<Button icon="ellipsis-vertical" label="More" />
		</div>
	</div>

	<div class="content" style={`--page-bg:${background}`}>
		<div class="blank" data-blank hidden={Boolean(url)}>
			<div class="hint" data-blank-hint hidden={recents.length > 0}>
				<span class="hint-badge"><Icon name="globe" size={12} /></span>
				<span class="hint-title">Where to?</span>
				<span class="hint-body">
					Type a URL to get started. Pages you visit will show up here.
				</span>
			</div>

			<div class="recents" data-blank-recents hidden={recents.length === 0}>
				{
					recents.slice(0, 8).map((recent) => (
						<div class="recent" data-recent-url={recent}>
							<Icon name="globe" size={12} />
							<span class="recent-url">{recent}</span>
						</div>
					))
				}
			</div>
		</div>

		<div class="mount" data-mount hidden={!url}><slot /></div>
	</div>
</div>

<style>
	.browser {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		background: var(--zz-bg);
		color: var(--zz-fg);
		font-family: var(--zz-font-ui);
	}

	.toolbar {
		display: flex;
		align-items: center;
		flex: none;
		gap: 4px;
		height: 40px;
		padding: 0 8px;
		border-bottom: 1px solid var(--zz-border);
	}
	.cluster {
		display: flex;
		align-items: center;
		flex: none;
		gap: 4px;
		color: var(--zz-fg-muted);
	}

	.strip {
		display: flex;
		align-items: center;
		flex: 1;
		gap: 4px;
		height: 100%;
		min-width: 0;
		overflow: hidden;
	}

	.address {
		display: flex;
		align-items: center;
		flex: 1;
		min-width: 160px;
		height: 24px;
		padding: 0 8px;
		border-radius: var(--zz-radius);
		corner-shape: squircle;
		background: var(--zz-wash-1);
	}
	.url {
		flex: 1;
		min-width: 0;
		padding: 0;
		border: 0;
		outline: none;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		background: transparent;
		color: var(--zz-fg);
		font-family: inherit;
		font-size: 12px;
		line-height: 1;
		-webkit-appearance: none;
		appearance: none;
	}
	.url::placeholder { color: var(--zz-fg-muted); opacity: 1; }
	.url::selection { background: var(--zz-selection); }

	.spinner {
		display: none;
		flex: none;
		width: 12px;
		height: 12px;
		margin-left: 6px;
		border: 1.5px solid var(--zz-fg-muted);
		border-top-color: transparent;
		border-radius: 50%;
		corner-shape: round;
		animation: zz-browser-spin 0.7s linear infinite;
	}
	.browser[data-loading] .spinner { display: block; }
	@keyframes zz-browser-spin { to { transform: rotate(1turn); } }
	@media (prefers-reduced-motion: reduce) {
		.spinner { animation: none; }
	}

	.pill {
		display: flex;
		align-items: center;
		flex: 1;
		gap: 2px;
		min-width: 40px;
		height: 24px;
		padding: 0 4px 0 10px;
		border-radius: var(--zz-radius);
		corner-shape: squircle;
		background: var(--zz-bg-1);
		cursor: pointer;
	}
	.pill:hover { background: var(--zz-hover-1); }
	.pill-label {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 12px;
		color: var(--zz-fg-muted);
	}
	.pill :global(.pill-close) {
		width: 18px;
		min-width: 18px;
		height: 18px;
		visibility: hidden;
	}
	.pill:hover :global(.pill-close) { visibility: visible; }

	.content {
		position: relative;
		display: flex;
		flex: 1;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		background: var(--page-bg);
	}

	.mount {
		display: flex;
		flex: 1;
		min-width: 0;
		min-height: 0;
	}
	.mount > :global(*) {
		flex: 1;
		min-width: 0;
		min-height: 0;
	}

	.blank {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 24px;
		overflow: hidden;
	}
	.blank[hidden],
	.mount[hidden] { display: none; }

	.hint {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		max-width: 440px;
		text-align: center;
	}
	.hint[hidden] { display: none; }
	.hint-badge {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		corner-shape: round;
		background: var(--zz-wash-2);
		color: var(--zz-fg-muted);
	}
	.hint-title { font-size: 13px; font-weight: 600; }
	.hint-body {
		font-size: 11px;
		line-height: 1.45;
		color: var(--zz-fg-muted);
	}

	.recents {
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 360px;
		gap: 4px;
	}
	.recents[hidden] { display: none; }

	.recent {
		display: flex;
		align-items: center;
		flex: none;
		gap: 8px;
		height: 32px;
		padding: 0 12px;
		border-radius: var(--zz-radius);
		corner-shape: squircle;
		background: var(--zz-wash-1);
		color: var(--zz-fg-muted);
		cursor: pointer;
	}
	.recent:hover { background: var(--zz-wash-2); }
	.recent-url {
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 12px;
		font-weight: 500;
		color: var(--zz-fg);
	}
</style>
