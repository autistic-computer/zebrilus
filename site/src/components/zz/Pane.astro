---
interface Props {
	flush?: boolean;
	background?: string;
	inactive?: boolean;
	id?: string;
	focused?: boolean;
	class?: string;
}

const { flush = false, background, inactive = false, id, focused, class: cls } = Astro.props;
---

<div
	class:list={['pane', flush && 'pane--flush', inactive && 'pane--inactive', cls]}
	style={background ? `--pane-bg:${background}` : undefined}
	data-pane={id}
	data-focused={focused ? '' : undefined}
>
	<slot />
	{inactive && <span class="scrim" aria-hidden="true" />}
</div>

<style>
	.pane {
		position: relative;
		display: flex;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		background: var(--pane-bg, var(--zz-bg));
		border: var(--zz-pane-border) solid var(--zz-border);
		border-radius: var(--zz-radius-pane);
		corner-shape: squircle;
	}
	.pane[data-focused] {
		border-color: var(--zz-focus-soft);
	}
	.pane--flush {
		border: 0;
		border-radius: 0;
	}
	.scrim {
		position: absolute;
		inset: 0;
		background: rgba(10, 10, 10, 0.3);
		pointer-events: none;
	}
</style>
