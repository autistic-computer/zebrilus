---
import './zz.css';

interface Props {
	width?: number;
	height?: number;
	sidebarWidth?: number;
	margin?: number;
	class?: string;
}

const { width = 2232, height = 1360, sidebarWidth = 278, margin = 6, class: cls } = Astro.props;
---

<div
	class:list={['scaler', cls]}
	style={`--w:${width}px;--h:${height}px;--sidebar-w:${sidebarWidth}px;--zz-pane-margin:${margin}px`}
>
	<div class="window zz-scope">
		<div class="shell">
			<slot name="sidebar" />
			<div class="content">
				<div class="canvas"><slot /></div>
			</div>
		</div>
	</div>
</div>

<style>
	.scaler {
		position: relative;
		z-index: 1;
		width: calc(var(--w) * var(--zz-scale, 1));
		height: calc(var(--h) * var(--zz-scale, 1));
		overflow: hidden;
	}
	.window {
		width: calc(var(--w) / var(--zz-zoom, 1));
		height: calc(var(--h) / var(--zz-zoom, 1));
		overflow: hidden;
		background: var(--zz-bg);
		color: var(--zz-fg);
		border-radius: calc(var(--zz-frame-radius, var(--zz-radius-window)) / (var(--zz-scale, 1) * var(--zz-zoom, 1)));
		corner-shape: squircle;
		transform: scale(calc(var(--zz-scale, 1) * var(--zz-zoom, 1)));
		transform-origin: top left;
	}
	.shell {
		position: relative;
		display: flex;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}
	.content {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
	}
	.canvas {
		flex: 1;
		min-width: 0;
		min-height: 0;
		padding: var(--zz-pane-margin);
	}
</style>
